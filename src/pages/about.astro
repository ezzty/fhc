---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdvantageCard from '../components/AdvantageCard.astro';
import { getCollection } from 'astro:content';

const advantages = (await getCollection('advantages')).sort((a, b) => a.data.sort - b.data.sort);

const iconMap: Record<string, string> = {
    "1-barley": "🏔️",
    "2-brewing": "🏺",
    "3-factory": "🏭",
    "4-quality": "✅",
};
---

<BaseLayout
    title="关于我们 | 西藏福海醇酒业有限公司 | 福海醇酒青稞酒官网 | 西藏酒厂 | 西藏白酒 | 青稞酒贴牌加盟定制OEM"
    description="西藏福海醇酒业有限公司，传承西藏传统酿酒工艺，打造青稞白酒典范。提供青稞酒贴牌、加盟、定制、OEM服务。"
    canonical="https://www.fuhaichun.cn/about/"
    ogTitle="关于我们 | 西藏福海醇酒业有限公司 | 福海醇酒青稞酒官网"
    ogDescription="西藏福海醇酒业有限公司，传承西藏传统酿酒工艺，打造青稞白酒典范。"
    activeNav="about"
>

<div class="about-page">
    <div class="about-shell">
        <h1 class="about-title">关于我们</h1>
        <div class="about-image-wrap">
            <img src="/images/other/factory.jpg" alt="福海醇酒厂">
        </div>
        <div class="about-text">
            <p>西藏福海醇酒业有限公司位于中国历史文化名城拉萨市曲水县，紧靠在西藏两大母亲河拉萨河、雅鲁藏布江交汇之处。</p>
            <p>福海醇酒业传承西藏悠久历史文化，整合西藏丰富资源，在传统古法中创新，匠心打造，精酿出具有"醇厚柔和、优雅绵甜、爽净味长"特点的系列品牌青稞白酒，如："红牦""福海醇""藏之福""天曲云水""福海大愿""福海同心""福海大印"等几大青稞白酒系列品牌，实现了品牌文化、传统青稞白酒酿造工艺及先进科技的结合。因其环境独特、原料独特、配料独特、工艺独特、风味独特，深受大家欢迎，产品远销各地。</p>
            <p>公司全体员工怀着立足西藏，放眼华夏的豪迈气概，团结奋斗，顽强拼博，在传统中求创新，在创新中提品质，努力把品质优良、更具民族特色的产品奉献给广大消费者，把西藏几千年的历史文化及"天曲云水，普降福海"的美丽传说，融入杯杯美酒，致力打造西藏青稞白酒典范，共创福海醇酒业辉煌明天！</p>
        </div>
    </div>
</div>

<section class="features" id="features">
    <div class="container">
        <h2 class="section-title">核心优势</h2>
        <div class="feature-grid">
            {advantages.map((adv) => (
                <AdvantageCard
                    title={adv.data.title}
                    icon={iconMap[adv.id] || "⭐"}
                    desc={adv.data.subtitle}
                    slug={adv.id}
                />
            ))}
        </div>
    </div>
</section>

</BaseLayout>

<style>
.about-page{margin-top:137px;padding:4rem 2rem 6rem}
.about-shell{max-width:1000px;margin:0 auto}
.about-title{text-align:center;font-size:2.5rem;margin-bottom:3rem;color:#0f172a}
.about-title::after{content:'';display:block;width:60px;height:4px;background:linear-gradient(90deg,#ef4444,#f97316);margin:1rem auto 0;border-radius:2px}
.about-image-wrap{border-radius:16px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,0.12);margin-bottom:3rem}
.about-image-wrap img{width:100%;display:block}
.about-text p{margin-bottom:1.5rem;font-size:1.05rem;color:#475569;text-indent:2em}
.about-text p:last-child{text-indent:0}

@media(max-width:900px){
    .about-title{font-size:1.8rem}
    .about-page{padding:2rem 1.5rem 4rem}
    .features{padding:3rem 1.5rem}
    .features .section-title{font-size:1.8rem}
}
</style>
