---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const products = await getCollection('products');
    return products.map((product) => ({
        params: { slug: product.id },
        props: { product },
    }));
}

const { product } = Astro.props;
const { name, image, series, alcohol, volume, aroma, origin, description, price, productType } = product.data;
const { Content } = await render(product);

// 从原始 body 提取第一张图片作为主图
const mainImage = image || (product.body.match(/!\[.*?\]\(([^)]+)\)/) || [])[1] || '/images/other/fhclogo.png';

// 构建规格列表
const specs = [
    { label: '酒精度', value: alcohol, icon: '🍶' },
    { label: '净含量', value: volume, icon: '📦' },
    { label: '香型', value: aroma, icon: '🌾' },
    { label: '产品类型', value: productType, icon: '🏷️' },
].filter(s => s.value);
---

<BaseLayout
    title={`${name} | 福海醇青稞酒产品详情 | 西藏福海醇酒业有限公司`}
    description={`${name}是福海醇酒业的${series}产品之一，传承西藏传统酿酒工艺，精选雪域高原优质青稞，口感醇厚柔和。`}
    canonical={`https://www.fuhaichun.cn/product/${product.id}/`}
    ogTitle={`${name} | 福海醇酒青稞酒产品详情`}
    ogImage={`https://www.fuhaichun.cn${mainImage}`}
>

<div class="product-detail-page">
    <div class="product-detail-shell">
        <!-- 主图 + 信息区 -->
        <div class="product-detail-hero">
            <div class="product-detail-image">
                <img src={mainImage} alt={name}>
            </div>
            <div class="product-detail-info">
                <h1 class="product-detail-title">{name}</h1>
                <p class="product-detail-series">{series}</p>
                <div class="product-detail-divider"></div>
                
                <div class="product-detail-price">
                    <span class="price-label">价格</span>
                    <span class="price-value">¥{price}</span>
                </div>
                
                {description && <p class="product-detail-desc">{description}</p>}
                
                {specs.length > 0 && (
                    <div class="product-specs">
                        {specs.map(s => (
                            <div class="spec-item">
                                <span class="spec-icon">{s.icon}</span>
                                <div class="spec-text">
                                    <span class="spec-label">{s.label}</span>
                                    <span class="spec-value">{s.value}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </div>
        </div>

        <!-- Markdown 正文区域 -->
        <div class="product-content">
            <h2 class="content-title">产品详情</h2>
            <div class="markdown-body">
                <Content />
            </div>
        </div>

        <!-- 操作按钮 -->
        <div class="product-detail-cta">
            <a href="/products/" class="btn-back">← 返回产品中心</a>
            <a href="tel:18602881137" class="btn-call">📞 咨询订购</a>
        </div>
    </div>
</div>

</BaseLayout>

<style>
.product-detail-page{margin-top:137px;padding:4rem 2rem 6rem;background:#f8fafc;min-height:calc(100vh - 137px)}
.product-detail-shell{max-width:1100px;margin:0 auto}

/* 主图 + 信息 */
.product-detail-hero{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,0.08)}
.product-detail-image{aspect-ratio:1/1;background:#fff;display:flex;align-items:center;justify-content:center;padding:2rem;border:1px solid #e8e8e8;border-radius:16px 0 0 16px}
.product-detail-image img{width:100%;height:100%;object-fit:contain;display:block}
.product-detail-info{padding:2.5rem 2.5rem 2.5rem 0}
.product-detail-title{font-size:2.2rem;color:#0f172a;margin-bottom:0.5rem}
.product-detail-series{font-size:1.1rem;color:#64748b;margin-bottom:1.5rem}
.product-detail-divider{width:60px;height:4px;background:linear-gradient(90deg,#ef4444,#f97316);border-radius:2px;margin-bottom:2rem}
.product-detail-desc{font-size:1.05rem;color:#475569;line-height:1.8;margin-bottom:2rem}

/* 价格 */
.product-detail-price{display:flex;align-items:center;gap:1rem;margin-bottom:2rem;padding:1rem 1.5rem;background:#fff8f0;border-radius:12px;border:2px solid #fbbf24}
.price-label{font-size:1rem;color:#64748b;font-weight:500}
.price-value{font-size:2rem;color:#ef4444;font-weight:bold}

/* 规格列表 */
.product-specs{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.spec-item{display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:#f8fafc;border-radius:10px;border:1px solid #e2e8f0}
.spec-icon{font-size:1.3rem;flex-shrink:0}
.spec-text{display:flex;flex-direction:column}
.spec-label{font-size:0.8rem;color:#94a3b8}
.spec-value{font-size:1rem;color:#0f172a;font-weight:600}

/* Markdown 正文 */
.product-content{margin-top:3rem;background:#fff;border-radius:16px;padding:2.5rem;box-shadow:0 10px 30px rgba(0,0,0,0.06)}
.content-title{text-align:center;font-size:1.8rem;color:#0f172a;margin-bottom:2rem;position:relative}
.content-title::after{content:'';display:block;width:60px;height:4px;background:linear-gradient(90deg,#ef4444,#f97316);margin:0.75rem auto 0;border-radius:2px}
.markdown-body{font-size:1.05rem;color:#475569;line-height:1.8}
.markdown-body p{margin-bottom:1.25rem}
.markdown-body img{max-width:950px;width:100%;display:block;margin:1.5rem auto;border-radius:12px;box-shadow:0 4px 16px rgba(0,0,0,0.08)}
.markdown-body h1,.markdown-body h2,.markdown-body h3{color:#0f172a;margin:2rem 0 1rem}
.markdown-body h3{font-size:1.3rem;padding-left:1rem;border-left:4px solid #ef4444}
.markdown-body ul,.markdown-body ol{margin:1rem 0 1.5rem 1.5rem}
.markdown-body li{margin-bottom:0.5rem}
.markdown-body table{width:100%;border-collapse:collapse;margin:1.5rem 0}
.markdown-body th,.markdown-body td{padding:0.75rem 1rem;border:1px solid #e2e8f0;text-align:left}
.markdown-body th{background:#f8fafc;font-weight:600;color:#0f172a}
.markdown-body blockquote{margin:1.5rem 0;padding:1rem 1.5rem;background:#f8fafc;border-left:4px solid #fbbf24;border-radius:0 8px 8px 0}
.markdown-body code{background:#f1f5f9;padding:0.2em 0.4em;border-radius:4px;font-size:0.9em}
.markdown-body pre{background:#1e293b;color:#e2e8f0;padding:1.5rem;border-radius:12px;overflow-x:auto;margin:1.5rem 0}
.markdown-body pre code{background:none;color:inherit}

/* 操作按钮 */
.product-detail-cta{text-align:center;margin-top:3rem;display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap}
.btn-back{display:inline-block;padding:0.8rem 2rem;background:#fff;color:#334155;text-decoration:none;border-radius:50px;font-size:1rem;font-weight:600;border:2px solid #e2e8f0;transition:all 0.3s}
.btn-back:hover{border-color:#ef4444;color:#ef4444}
.btn-call{display:inline-block;padding:0.8rem 2rem;background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;text-decoration:none;border-radius:50px;font-size:1rem;font-weight:600;transition:all 0.3s}
.btn-call:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(239,68,68,0.35)}

@media(max-width:900px){
    .product-detail-hero{grid-template-columns:1fr}
    .product-detail-info{padding:1.5rem}
    .product-detail-title{font-size:1.8rem}
    .product-detail-page{padding:2rem 1.5rem 4rem}
    .product-specs{grid-template-columns:1fr}
    .gallery-grid{grid-template-columns:1fr}
}
</style>
